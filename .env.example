# local: authenticated SQLite on this computer; supabase: Supabase Auth + PostgreSQL
LUKI_STORAGE=local
# Local mode is deliberately refused on public hosts. Use loopback URLs.
# Only needed in supabase mode. Never put a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Cloud-only: fixed HTTPS address and one verified Supabase Auth account.
APP_ORIGIN=
LUKI_ALLOWED_EMAIL=
# Optional: default is ./data/luki-home.sqlite
LUKI_DB_PATH=
